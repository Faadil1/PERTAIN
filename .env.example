# Set to 1 only for the clearly-labeled seeded evaluation fallback.
PERTAIN_DEMO_MODE=1

# Evidence freshness guard. Relevant Jira evidence older than this fails closed to UNKNOWN.
PERTAIN_EVIDENCE_MAX_AGE_MINUTES=30

# Gmail / compatible Gmail API surface
GMAIL_BASE_URL=https://gmail.googleapis.com
GMAIL_ACCESS_TOKEN=
GMAIL_DRAFT_ID=

# Salesforce / compatible Salesforce API surface
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v61.0

# Jira / compatible Jira API surface
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_JQL=labels = pertain

# Optional bounded semantic model (OpenAI-compatible chat-completions API).
# Without these, PERTAIN uses a deterministic, explicitly-labelled parser fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
